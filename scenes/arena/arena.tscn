[sub_resource type="Shader" id="Shader_surface_pattern"]
code = "shader_type spatial;\n\nvarying vec3 local_position;\n\nuniform vec4 base_color : source_color = vec4(0.075, 0.125, 0.18, 1.0);\nuniform vec4 checker_color : source_color = vec4(0.11, 0.2, 0.27, 1.0);\nuniform vec4 grid_color : source_color = vec4(0.18, 0.52, 0.58, 1.0);\nuniform vec4 ring_color : source_color = vec4(0.88, 0.5, 0.15, 1.0);\nuniform float cell_size = 1.5;\nuniform float grid_width = 0.035;\nuniform float ring_spacing = 3.0;\nuniform float ring_width = 0.035;\n\nvoid vertex() {\n\tlocal_position = VERTEX;\n}\n\nvoid fragment() {\n\tvec2 point = local_position.xz;\n\tvec2 cell_uv = fract(point / cell_size);\n\tfloat checker = mod(floor(point.x / cell_size) + floor(point.y / cell_size), 2.0);\n\tvec2 edge_distance = min(cell_uv, vec2(1.0) - cell_uv);\n\tfloat grid_distance = min(edge_distance.x, edge_distance.y);\n\tfloat grid_aa = max(fwidth(grid_distance), 0.002);\n\tfloat grid = 1.0 - smoothstep(grid_width - grid_aa, grid_width + grid_aa, grid_distance);\n\n\tfloat ring_phase = fract(length(point) / ring_spacing);\n\tfloat ring_distance = min(ring_phase, 1.0 - ring_phase);\n\tfloat ring_aa = max(fwidth(ring_distance), 0.002);\n\tfloat ring = 1.0 - smoothstep(ring_width - ring_aa, ring_width + ring_aa, ring_distance);\n\n\tvec3 color = mix(base_color.rgb, checker_color.rgb, checker * 0.42);\n\tcolor = mix(color, grid_color.rgb, grid * 0.72);\n\tcolor = mix(color, ring_color.rgb, ring * 0.78);\n\tALBEDO = color;\n\tROUGHNESS = 0.82;\n\tMETALLIC = 0.08;\n}\n"

