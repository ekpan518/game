[sub_resource type="Shader" id="Shader_speed_lines"]
code = "shader_type canvas_item;\n\nuniform float intensity : hint_range(0.0, 1.0) = 0.0;\n\nvoid fragment() {\n\tvec2 radial = UV - vec2(0.5);\n\tfloat distance_from_center = length(radial);\n\tfloat angle = atan(radial.y, radial.x);\n\tfloat rays = pow(max(0.0, sin(angle * 43.0 + TIME * 0.8)), 22.0);\n\tfloat outward = smoothstep(0.18, 0.62, distance_from_center);\n\tfloat pulse = 0.6 + 0.4 * sin(distance_from_center * 42.0 - TIME * 8.0);\n\tfloat alpha = intensity * rays * outward * pulse * 0.28;\n\tCOLOR = vec4(0.72, 0.9, 1.0, alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_speed_lines"]
resource_local_to_scene = true
shader = SubResource("Shader_speed_lines")
shader_parameter/intensity = 0.0

